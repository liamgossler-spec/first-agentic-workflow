{{ 'posturefix-page.css' | asset_url | stylesheet_tag }}

<div class="pfx">
  <div class="pfx-section" style="background:{{ section.settings.bg_color }};">
    <div class="pfx-wrap">
      <h2 class="pfx-center">{{ section.settings.heading }}</h2>
      <p class="pfx-sub pfx-center">{{ section.settings.sub }}</p>
      <div class="pfx-tbl-scroll">
        <table class="pfx-compare-table">
          <tr>
            <th></th>
            <th class="pfx-hl">{{ section.settings.col_ours }}</th>
            <th>{{ section.settings.col_a }}</th>
            <th>{{ section.settings.col_b }}</th>
          </tr>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.label }}</td>
              <td{% if block.settings.ours contains '✓' %} class="pfx-yes"{% elsif block.settings.ours contains '✕' %} class="pfx-no"{% endif %}>{{ block.settings.ours }}</td>
              <td{% if block.settings.alt_a contains '✓' %} class="pfx-yes"{% elsif block.settings.alt_a contains '✕' %} class="pfx-no"{% endif %}>{{ block.settings.alt_a }}</td>
              <td{% if block.settings.alt_b contains '✓' %} class="pfx-yes"{% elsif block.settings.alt_b contains '✕' %} class="pfx-no"{% endif %}>{{ block.settings.alt_b }}</td>
            </tr>
          {%- endfor -%}
        </table>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PFX Comparison",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Smart Shoppers Choose Alignly" },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Compare your options for fixing posture and easing back tension." },
    { "type": "text", "id": "col_ours", "label": "Your column title", "default": "PostureFix Pro™" },
    { "type": "text", "id": "col_a", "label": "Competitor column A", "default": "Cheap Braces" },
    { "type": "text", "id": "col_b", "label": "Competitor column B", "default": "Chiropractor Visits" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f5f8f9" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        { "type": "text", "id": "label", "label": "Feature", "default": "Feature name" },
        { "type": "text", "id": "ours", "label": "Your value", "default": "✓", "info": "Start with ✓ or ✕ for colored icons, or write any text." },
        { "type": "text", "id": "alt_a", "label": "Competitor A value", "default": "✕" },
        { "type": "text", "id": "alt_b", "label": "Competitor B value", "default": "✕" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "PFX Comparison",
      "blocks": [
        { "type": "row", "settings": { "label": "Instant posture support", "ours": "✓", "alt_a": "✓", "alt_b": "✕" } },
        { "type": "row", "settings": { "label": "Comfortable for daily wear", "ours": "✓", "alt_a": "✕", "alt_b": "—" } },
        { "type": "row", "settings": { "label": "Builds lasting muscle memory", "ours": "✓", "alt_a": "✕", "alt_b": "✓" } },
        { "type": "row", "settings": { "label": "Discreet under clothing", "ours": "✓", "alt_a": "✕", "alt_b": "—" } },
        { "type": "row", "settings": { "label": "One-time cost", "ours": "✓ one payment", "alt_a": "✓ but wears out fast", "alt_b": "✕ $65–$200 per visit" } },
        { "type": "row", "settings": { "label": "Money-back guarantee", "ours": "✓ 30 days", "alt_a": "✕ rarely", "alt_b": "✕" } }
      ]
    }
  ]
}
{% endschema %}
