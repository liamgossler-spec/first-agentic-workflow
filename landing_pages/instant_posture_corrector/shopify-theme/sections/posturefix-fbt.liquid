{{ 'posturefix-page.css' | asset_url | stylesheet_tag }}

<div class="pfx">
  <div class="pfx-section" style="background:{{ section.settings.bg_color }};">
    <div class="pfx-wrap">
      <h2 class="pfx-center">{{ section.settings.heading }}</h2>
      <p class="pfx-sub pfx-center">{{ section.settings.sub }}</p>
      <div class="pfx-grid3">
        {%- for block in section.blocks -%}
          {%- assign fbt_product = block.settings.product -%}
          <div class="pfx-card pfx-fbt-item" {{ block.shopify_attributes }}>
            {%- if fbt_product != blank -%}
              {%- assign fbt_variant = fbt_product.selected_or_first_available_variant -%}
              {%- if block.settings.badge != blank -%}<span class="pfx-flag">{{ block.settings.badge }}</span>{%- endif -%}
              <a href="{{ fbt_product.url }}" class="pfx-fbt-img">
                {%- if fbt_product.featured_image -%}
                  {{ fbt_product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: fbt_product.featured_image.alt | default: fbt_product.title }}
                {%- else -%}
                  {{ 'product-3' | placeholder_svg_tag: 'pfx-placeholder' }}
                {%- endif -%}
              </a>
              <div class="pfx-fbt-title">{{ fbt_product.title }}</div>
              <div class="pfx-fbt-price">
                <b>{{ fbt_variant.price | money }}</b>
                {%- if fbt_variant.compare_at_price > fbt_variant.price -%}
                  <s>{{ fbt_variant.compare_at_price | money }}</s>
                {%- endif -%}
              </div>
              {%- if fbt_variant.available -%}
                {%- assign fbt_form_id = 'pfx-fbt-' | append: section.id | append: '-' | append: block.id -%}
                {% form 'product', fbt_product, id: fbt_form_id %}
                  <input type="hidden" name="id" value="{{ fbt_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="pfx-btn pfx-btn--small" style="width:100%">{{ section.settings.add_label }}</button>
                {% endform %}
              {%- else -%}
                <span class="pfx-btn pfx-btn--small" style="width:100%;opacity:.5;pointer-events:none">{{ section.settings.soldout_label }}</span>
              {%- endif -%}
            {%- else -%}
              <div class="pfx-fbt-empty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:38px;height:38px;opacity:.5;margin:0 auto 8px"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.5"/><path d="m21 15-4.5-4.5L9 18"/></svg>
                Pick a product for this slot in the theme editor
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PFX Bought Together",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Bought Together" },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Complete your recovery routine — customers pair these with the PostureFix Pro™." },
    { "type": "text", "id": "add_label", "label": "Add button label", "default": "+ Add to Order" },
    { "type": "text", "id": "soldout_label", "label": "Sold out label", "default": "Sold Out" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Product slot",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "info": "e.g. BUNDLE DEAL" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "PFX Bought Together",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
