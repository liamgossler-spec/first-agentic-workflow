{{ 'posturefix-page.css' | asset_url | stylesheet_tag }}

<div class="pfx">
  <div class="pfx-headerbar{% if section.settings.sticky %} pfx-headerbar--sticky{% endif %}">
    <div class="pfx-wrap pfx-nav">
      {%- if section.settings.logo -%}
        <a href="{{ routes.root_url }}"><img class="pfx-logo-img" src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ section.settings.brand_main }}{{ section.settings.brand_accent }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" loading="lazy"></a>
      {%- else -%}
        <a href="{{ routes.root_url }}" class="pfx-logo">{{ section.settings.brand_main }}<span>{{ section.settings.brand_accent }}</span></a>
      {%- endif -%}
      <a class="pfx-btn pfx-btn--small" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PFX Header",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image (optional)" },
    { "type": "text", "id": "brand_main", "label": "Brand name", "default": "Align" },
    { "type": "text", "id": "brand_accent", "label": "Brand name (accent part)", "default": "ly" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get 33% Off" },
    { "type": "text", "id": "cta_link", "label": "Button link", "default": "#posturefix-buy" },
    { "type": "checkbox", "id": "sticky", "label": "Stick to top on scroll", "default": false, "info": "Leave off if your theme header is already sticky." }
  ],
  "presets": [{ "name": "PFX Header" }]
}
{% endschema %}
