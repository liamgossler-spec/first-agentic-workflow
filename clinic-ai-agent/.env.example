# העתיקו קובץ זה ל-.env והכניסו את המפתח האמיתי שלכם.
# מפתח Anthropic API — מתקבל בכתובת https://console.anthropic.com/
ANTHROPIC_API_KEY=

# אופציונלי — הפורט שבו ירוץ השרת (ברירת מחדל: 3000)
# PORT=3000

# אופציונלי — נתיב לקובץ הגדרות קליניקה אחר (לשימוש חוזר בין לקוחות).
# ברירת מחדל: clinic-config.json בתיקיית הפרויקט.
# CLINIC_CONFIG_PATH=./clinic-config.json

# ── ספק ה-CRM ─────────────────────────────────────────────
# local   = מאגר מקומי (ברירת מחדל; טוב לדמו ולבדיקות)
# altegio = חיבור ל-Altegio (alteg.io) — היומן/CRM האמיתי של הקליניקה.
#           הזמינות וקביעת התורים יעברו ל-Altegio; השיחות נשמרות מקומית.
# CRM_PROVIDER=altegio

# הגדרות Altegio (נדרשות רק כאשר CRM_PROVIDER=altegio):
# ALTEGIO_PARTNER_TOKEN=    # טוקן שותף (מ-Altegio)
# ALTEGIO_USER_TOKEN=       # טוקן משתמש
# ALTEGIO_COMPANY_ID=       # מזהה העסק/הסניף
# ALTEGIO_STAFF_ID=0        # מזהה מטפל (0 = כל מטפל זמין)
# ALTEGIO_SERVICE_ID=       # מזהה שירות ברירת מחדל (אופציונלי)
# ALTEGIO_BASE=https://api.alteg.io/api/v1
