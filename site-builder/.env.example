# === Bildy — site-builder/.env ===

# Anthropic API key (required for real site generation; without it Bildy runs in demo mode)
# Get one at: https://platform.claude.com/
ANTHROPIC_API_KEY=

# Model used for generation/editing (default: claude-opus-4-8)
# SITE_BUILDER_MODEL=claude-opus-4-8

# --- GoHighLevel (optional — lead sync to the GHL CRM) ---
# Private Integration Token (GHL: Settings → Private Integrations, scope: contacts.write)
GHL_API_KEY=

# Default Location (sub-account) that receives leads when a project doesn't set its own
GHL_LOCATION_ID=

# Advanced (rarely needed):
# GHL_API_BASE=https://services.leadconnectorhq.com
# GHL_API_VERSION=2021-07-28

# Server port
# PORT=4000
