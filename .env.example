# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.
#
# Add keys as workflows need them. Examples:

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Web scraping (uncomment what you use) ---
# FIRECRAWL_API_KEY=
# SCRAPINGBEE_API_KEY=

# --- Lead prospecting (find_prospects.py) ---
# Google Cloud Console -> enable "Places API (New)" -> Credentials -> API key
GOOGLE_PLACES_API_KEY=

# --- GoHighLevel (ghl_setup.py) ---
# Agency-level Private Integration token: GHL Settings -> Private Integrations
GHL_API_TOKEN=
# Optional; auto-discovered when empty:
GHL_COMPANY_ID=

# --- Google (Sheets / Slides / Drive) ---
# Uses OAuth via credentials.json + token.json, not keys here.
# Place credentials.json in the project root after creating an
# OAuth client in Google Cloud Console.
