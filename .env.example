# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.
#
# Add keys as workflows need them. Examples:

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Clinic AI chatbot: WhatsApp via GreenAPI (tools/clinic_bot_whatsapp.py) ---
# GREENAPI_ID_INSTANCE=
# GREENAPI_API_TOKEN=

# --- Lead finder: Google Places (tools/find_clinics.py) ---
# GOOGLE_PLACES_API_KEY=

# --- Web scraping (uncomment what you use) ---
# FIRECRAWL_API_KEY=
# SCRAPINGBEE_API_KEY=

# --- Google (Sheets / Slides / Drive) ---
# Uses OAuth via credentials.json + token.json, not keys here.
# Place credentials.json in the project root after creating an
# OAuth client in Google Cloud Console.
