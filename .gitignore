# Secrets & credentials — NEVER commit these
.env
credentials.json
token.json
*.pem
*.key

# Temp / regenerable processing files
.tmp/
!.tmp/.gitkeep

# Build artifacts (regenerable site bundles for deploy)
*.zip

# Competitor analysis: generated deliverables & research history (regenerable)
reports/*.pdf
data/snapshots/*/
!data/snapshots/.gitkeep
# Brand assets are local to each user; commit the structure, not the logo.
brand/logo.*
brand/fonts/*
!brand/fonts/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# OS / editor
.DS_Store
.vscode/
.idea/

# Local Claude Code settings (machine-specific)
.claude/settings.local.json
